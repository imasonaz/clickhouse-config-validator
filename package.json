{
  "name": "clickhouse-config-check",
  "version": "1.1.1",
  "description": "Validate ClickHouse server, users and Keeper configuration files",
  "private": true,
  "type": "module",
  "bin": {
    "ch-config-check": "bin/ch-config-check.mjs"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "check": "npm run lint && npm test",
    "zip": "sh tools/zip.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
